{
  "title": "System Overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP Requests",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {"expr": "sum(rate(http_server_requests_seconds_count[5m])) by (application)", "refId": "A"}
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM Memory",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {"expr": "sum(jvm_memory_used_bytes) by (area, application)", "refId": "A"}
      ]
    }
  ]
}
